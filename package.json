{
  "name": "joypacket",
  "version": "0.1.0",
  "description": "Little packets of joy for the web: a pixel pet that peeks over the edge of your page.",
  "license": "MIT",
  "author": "Gaurav Pandey (https://github.com/gaurav-pndy)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaurav-pndy/joypacket.git"
  },
  "homepage": "https://gaurav-pndy.github.io/joypacket/",
  "bugs": {
    "url": "https://github.com/gaurav-pndy/joypacket/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pixel-pet": {
      "types": "./dist/pixel-pet.d.ts",
      "import": "./dist/pixel-pet.js"
    },
    "./pets": {
      "types": "./dist/pets.d.ts",
      "import": "./dist/pets.js"
    },
    "./style.css": "./dist/joypacket.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "react",
    "pixel-art",
    "pixel-pet",
    "mascot",
    "companion",
    "widget",
    "cat",
    "dog",
    "fun",
    "joy"
  ],
  "publishConfig": {
    "access": "public"
  }
}
